# Phase-I-local histogram_statistics_v2 snapshot. Keep this list in dependency
# order and self-contained under fe_board/fe/ip/histogram_statistics.

set hist_qip_dir [file dirname [file normalize [info script]]]

foreach hist_vhdl_file {
    histogram_statistics_v2_pkg.vhd
    true_dual_port_ram_single_clock.vhd
    hit_fifo.vhd
    rr_arbiter.vhd
    bin_divider.vhd
    coalescing_queue.vhd
    pingpong_sram.vhd
    histogram_statistics_v2.vhd
} {
    set_global_assignment -name VHDL_FILE [file join $hist_qip_dir $hist_vhdl_file]
}

unset hist_vhdl_file
unset hist_qip_dir
